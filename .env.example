# Database
DATABASE_URL=postgresql://itticket:itticket@postgres:5432/it_ticket_db
POSTGRES_USER=itticket
POSTGRES_PASSWORD=itticket
POSTGRES_DB=it_ticket_db

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Line
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_GROUP_IT_ID=

# Ollama (A5000 Server)
OLLAMA_BASE_URL=http://100.94.37.18:11434
OLLAMA_MODEL=gemma4:12b

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=it-ticket-attachments
MINIO_SECURE=false

# App
APP_ENV=production
FRONTEND_URL=http://localhost:3000

# Follow-up timings (minutes)
FOLLOWUP_DELAY_MINUTES=10
ESCALATE_DELAY_MINUTES=30

# ngrok (dev only)
NGROK_AUTHTOKEN=

# Frontend dev proxy (docker: ชี้ไป backend service)
VITE_API_PROXY=http://backend:8000

# คำเรียกบอทในกลุ่ม (คั่นด้วย comma)
GROUP_TRIGGER_KEYWORDS=itadmin,@itadmin,/itadmin
