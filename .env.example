# Database
DATABASE_URL=postgresql://itticket:itticket@postgres:5432/it_ticket_db
POSTGRES_USER=itticket
POSTGRES_PASSWORD=itticket
POSTGRES_DB=it_ticket_db

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Line
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_GROUP_IT_ID=
# Channel ID ของ LINE Login channel ที่ผูก LIFF app — ใช้ verify ID token จากฟอร์ม LIFF
LINE_CHANNEL_ID=
# LIFF ID (สร้าง LIFF app ใน LINE Developers Console ชี้ Endpoint URL มาที่ <frontend>/liff/form)
VITE_LIFF_ID=
# LIFF base URL — บอทแปะปุ่มฟอร์มโดยต่อ ?form=<slug> ท้าย (https://liff.line.me/<liff id>)
LIFF_BASE_URL=

# Ollama (A5000 Server)
OLLAMA_BASE_URL=http://100.94.37.18:11434
OLLAMA_MODEL=gemma4:12b

# RAG embedding (ต้อง `ollama pull` ที่เครื่อง A5000 ก่อน)
OLLAMA_EMBED_MODEL=bge-m3
EMBED_DIM=1024
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.4

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=it-ticket-attachments
MINIO_SECURE=false

# App
APP_ENV=production
FRONTEND_URL=http://localhost:3000

# Follow-up flow: ผู้ใช้เงียบกลางบทสนทนา → ถามซ้ำ (10m) → เปิด ticket อัตโนมัติ (30m)
# FOLLOWUP_ENABLED เป็นค่าตั้งต้น — เปิด/ปิดสดได้จากหน้า Settings (เก็บใน DB)
FOLLOWUP_ENABLED=true
FOLLOWUP_DELAY_MINUTES=10
ESCALATE_DELAY_MINUTES=30

# ngrok (dev only)
NGROK_AUTHTOKEN=

# Frontend dev proxy (docker: ชี้ไป backend service)
VITE_API_PROXY=http://backend:8000

# คำเรียกบอทในกลุ่ม (คั่นด้วย comma)
GROUP_TRIGGER_KEYWORDS=itadmin,@itadmin,/itadmin
# multi-turn intake — บทสนทนา active ภายในกี่นาที (ต่ออายุทุกครั้งที่ผู้ใช้ตอบ)
CONVERSATION_MINUTES=15

# Initial admin (deploy.sh seeds this on first deploy if users table is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
NGROK_DOMAIN=
